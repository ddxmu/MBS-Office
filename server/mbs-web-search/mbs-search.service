[Unit]
Description=Mbs Office web search
After=network-online.target
[Service]
User=www-data
Group=www-data
ExecStart=/usr/bin/python3 /opt/mbs-search/search.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
